{
  // ============================================================
  // CSS 검사 설정
  // ============================================================

  // VS Code 기본 CSS 검사기 비활성화
  // → @theme, @utility 같은 Tailwind v4 전용 문법을 기본 검사기가 모름
  // → 끄지 않으면 "Unknown at rule @theme" 에러가 계속 뜸
  "css.validate": false,
  "scss.validate": false,

  // ============================================================
  // Tailwind CSS IntelliSense 설정
  // ============================================================

  // CSS 파일을 tailwindcss 언어로 인식
  // → @theme, @utility 등 Tailwind 문법 자동완성 및 오류 억제
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // Tailwind 진입점 파일 명시
  // → 개별 CSS 파일(colors.css 등)이 어느 Tailwind 설정에 속하는지 알려줌
  // → 없으면 IntelliSense가 개별 파일을 Tailwind 파일로 인식 못함
  "tailwindCSS.experimental.configFile": "src/theme/tailwind.css",

  // ============================================================
  // 코드 포맷 설정
  // ============================================================

  // 전체 기본 포매터: Prettier
  // → 저장(Cmd+S) 시 자동으로 코드 정리
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // TypeScript 파일 포매터
  // → Prettier로 통일 (들여쓰기, 따옴표, 세미콜론 등 자동 정리)
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // HTML 파일 포매터
  // → Prettier + angular 파서 사용 (.prettierrc에 설정됨)
  // → 레거시는 VS Code 기본 html 포매터 사용했는데 Angular 템플릿 문법 깨지는 경우 있었음
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // JSON 파일 포매터
  // → Prettier 대신 VS Code 기본 JSON 포매터 사용
  // → JSON은 Prettier 없이도 충분히 정리됨
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  // JSONC (주석 있는 JSON, tsconfig 등) 포매터
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  // ============================================================
  // TypeScript 설정
  // ============================================================

  // 파일 이동/이름 변경 시 import 경로 자동 변경 비활성화
  // → FSD 구조에서 파일 이동이 잦은데, 자동 변경이 의도치 않은 import 수정을 유발할 수 있음
  // → 직접 확인하고 수정하는 게 안전
  "typescript.updateImportsOnFileMove.enabled": "never"
}
