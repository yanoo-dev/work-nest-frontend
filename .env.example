# 환경변수 템플릿 — 실제 값이 담긴 .env.* 파일은 커밋하지 않는다.
#
# 사용법
#   개발: .env.development 를 만들고 아래 값을 채운다 (npm run dev)
#   운영: .env.production 을 만들고 아래 값을 채운다 (npm run build)
#         배포(Vercel)는 대시보드 Environment Variables 에 등록하는 것이 표준
#
# 값 예시
#   개발 - http://localhost:3000/api
#   운영 - https://<머신명>.<테일넷>.ts.net/api   (NUC + Tailscale Funnel)

VITE_API_BASE_URL=
